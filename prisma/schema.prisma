model HousekeepingTask {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String             @db.Uuid
  branchId                 String             @db.Uuid
  roomId                   String             @db.Uuid
  assigneeId               String?            @db.Uuid // NULL = unassigned
  taskDate                 DateTime           @db.Date
  status                   HousekeepingStatus @default(pending)
  priority                 Int?               @db.SmallInt // 1 = urgent (guest arriving soon), 3 = normal
  triggerEvent             String?            @db.VarChar(30) // checkout | scheduled | walkin | manual
  triggeredByReservationId String?            @db.Uuid
  notes                    String?
  completedAt              DateTime?          @db.Timestamptz(6)
  completedBy              String?            @db.Uuid
  createdAt                DateTime           @default(now()) @db.Timestamptz(6)

  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room                   Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee               User?        @relation("HkAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedByUser        User?        @relation("HkCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  triggeredByReservation Reservation? @relation(fields: [triggeredByReservationId], references: [id], onDelete: SetNull)

  @@index([branchId, taskDate, status])
  @@index([assigneeId, taskDate, status])
  @@map("housekeeping_tasks")
}

model Shift {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @db.Uuid
  branchId            String    @db.Uuid
  agentId             String    @db.Uuid
  shiftType           ShiftType
  activeOutletId      String?   @db.Uuid // POS session outlet selection (staff with multiple outlets)
  openedAt            DateTime  @default(now()) @db.Timestamptz(6)
  closedAt            DateTime? @db.Timestamptz(6) // NULL = shift still open
  openingFloat        Decimal?  @db.Decimal(12, 2)
  openingBreakdown    Json? // [{denomination, count}]
  systemCashTotal     Decimal?  @db.Decimal(12, 2) // calculated on close
  closingCashCounted  Decimal?  @db.Decimal(12, 2)
  closingBreakdown    Json?
  variance            Decimal?  @db.Decimal(12, 2) // closingCashCounted − systemCashTotal
  varianceExplanation String? // required if ABS(variance) > branch threshold
  handoverNotes       String?

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agent        User    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  activeOutlet Outlet? @relation(fields: [activeOutletId], references: [id], onDelete: SetNull)

  issues    ShiftIssue[]
  payments  Payment[]
  posOrders PosOrder[]

  @@index([branchId, closedAt])
  @@index([branchId, openedAt(sort: Desc)])
  @@map("shifts")
}

model ShiftIssue {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  shiftId     String        @db.Uuid
  description String
  priority    IssuePriority @default(medium)
  status      IssueStatus   @default(open)
  resolution  String?
  resolvedBy  String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  resolvedAt  DateTime?     @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift          Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  resolvedByUser User?  @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([shiftId, status])
  @@map("shift_issues")
}

model MaintenanceOrder {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String              @db.Uuid
  branchId              String              @db.Uuid
  roomId                String?             @db.Uuid
  assetId               String?             @db.Uuid
  title                 String              @db.VarChar(200)
  description           String?
  priority              MaintenancePriority @default(medium)
  status                MaintenanceStatus   @default(open)
  takesRoomOutOfService Boolean             @default(false) // TRUE sets room.heldStatus = out_of_order atomically
  photoUrls             String[]            @default([]) // DocumentStorageAdapter URLs, same convention as ID document photos
  reportedBy            String?             @db.Uuid
  assignedTo            String?             @db.Uuid
  completionNotes       String?
  partsUsed             String[]            @default([])
  resolvedAt            DateTime?           @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room           Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  asset          Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reportedByUser User?  @relation("MaintReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)
  assignedToUser User?  @relation("MaintAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@map("maintenance_orders")
}

model Asset {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @db.Uuid
  branchId            String    @db.Uuid
  roomId              String?   @db.Uuid // NULL = common-area asset
  name                String    @db.VarChar(200)
  category            String?   @db.VarChar(100) // hvac | plumbing | electrical | furniture | appliance
  serialNumber        String?   @db.VarChar(100)
  purchaseDate        DateTime? @db.Date
  warrantyUntil       DateTime? @db.Date
  serviceIntervalDays Int? // preventive maintenance cadence — "next service due" = last resolved order's resolvedAt (or purchaseDate if none yet) + this
  notes               String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  maintenanceOrders MaintenanceOrder[]

  @@index([branchId])
  @@map("assets")
}

model RegistrationCard {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String    @db.Uuid
  reservationId String    @db.Uuid
  guestId       String    @db.Uuid
  fields        Json // snapshot of guest data at check-in
  signatureData String? // base64 SVG/PNG from signature pad; NULL = unsigned
  signedAt      DateTime? @db.Timestamptz(6)
  witnessedBy   String?   @db.Uuid // front desk agent
  documentUrl   String? // S3 URL of generated PDF (encrypted bucket)
  generatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  retainUntil   DateTime? @db.Date // regulatory retention end date

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation     Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest           GuestProfile @relation(fields: [guestId], references: [id], onDelete: Restrict)
  witnessedByUser User?        @relation(fields: [witnessedBy], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([guestId, generatedAt(sort: Desc)])
  @@index([branchId, retainUntil])
  @@map("registration_cards")
}

model OverbookingConfig {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  branchId       String    @db.Uuid
  roomTypeId     String?   @db.Uuid // NULL = applies to all types
  globalEnabled  Boolean   @default(false) // branch-level master switch (spec: allowOverbooking)
  maxOverbookPct Decimal?  @db.Decimal(5, 2) // 10.00 = allow 10% over capacity
  alertAtPct     Decimal?  @db.Decimal(5, 2)
  validFrom      DateTime? @db.Date
  validTo        DateTime? @db.Date
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy      String?   @db.Uuid

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType      RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  updatedByUser User?     @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([branchId, roomTypeId])
  @@map("overbooking_config")
}

model Outlet {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @db.Uuid
  branchId   String         @db.Uuid
  name       String         @db.VarChar(150) // "Main Restaurant", "Poolside Bar", "Zen Spa"
  category   OutletCategory // grouping for management reports
  chargeType ChargeType // stamped on every line item this outlet posts — staff never choose
  isActive   Boolean        @default(true) // inactive = hidden from POS selector, kept for history
  sortOrder  Int?
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  ratePlans      RatePlan[]
  lineItems      LineItem[]
  activeInShifts Shift[]
  userOutlets    UserOutlet[]
  menuItems      MenuItem[]
  posOrders      PosOrder[]

  @@index([branchId, isActive])
  @@index([branchId, category])
  @@map("outlets")
}

model UserOutlet {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  outletId   String   @db.Uuid
  branchId   String   @db.Uuid // denormalised for efficient RLS + branch filtering
  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User   @relation("UserOutletUser", fields: [userId], references: [id], onDelete: Cascade)
  outlet         Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedByUser User?  @relation("UserOutletAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, outletId])
  @@index([userId, branchId])
  @@index([outletId])
  @@map("user_outlets")
}

// ---------------------------------------------------------------------------
// Point of Sale (growth plan Month 10)
// ---------------------------------------------------------------------------

// One thing an outlet sells. Soft-deleted rather than removed, so past
// orders' snapshots still read sensibly.
model MenuItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String    @db.Uuid
  outletId    String    @db.Uuid
  name        String    @db.VarChar(150)
  category    String    @db.VarChar(60) // the terminal's category tabs: "Starters", "Mains", "Drinks"
  price       Decimal   @db.Decimal(12, 2) // before tax — tax follows the branch's rules for the outlet's charge type
  isAvailable Boolean   @default(true) // false = 86'd: greyed out on the terminal, can't be ordered
  // [{ name, selection: 'single' | 'multi', required, options: [{ label, price }] }] — an option's price adds to the item's
  modifiers   Json?
  sortOrder   Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, category])
  @@map("menu_items")
}

enum PosSettlement {
  room // charged to an in-house guest's folio
  cash
  card

  @@map("pos_settlement_enum")
}

// A sale at an outlet — the outlet's own sales ledger, however it was
// settled. A room charge ALSO becomes one line on the guest's folio
// (`lineItemId`), posted through FoliosService like any other charge; a cash
// sale counts toward the cashier's shift drawer (`shiftId`).
model PosOrder {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @db.Uuid
  branchId      String        @db.Uuid
  outletId      String        @db.Uuid
  orderNo       Int // sequential per outlet — "Order #42" on the receipt
  settlement    PosSettlement
  tableNumber   String?       @db.VarChar(20)
  // Snapshot at the moment of sale: [{ menuItemId, name, qty, unitPrice, modifiers: [{ group, label, price }], lineTotal }]
  items         Json
  subtotal      Decimal       @db.Decimal(12, 2)
  taxTotal      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @db.Char(3)
  reservationId String?       @db.Uuid // room: the in-house stay it was charged to
  folioId       String?       @db.Uuid
  lineItemId    String?       @unique @db.Uuid // room: the folio charge this order became
  shiftId       String?       @db.Uuid // cash: the drawer it went into
  createdBy     String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  voidedAt      DateTime?     @db.Timestamptz(6)
  voidedBy      String?       @db.Uuid
  voidReason    String?       @db.VarChar(500)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  folio       Folio?       @relation(fields: [folioId], references: [id], onDelete: Restrict)
  lineItem    LineItem?    @relation(fields: [lineItemId], references: [id], onDelete: Restrict)
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([outletId, orderNo])
  @@index([branchId, createdAt])
  @@index([shiftId])
  @@map("pos_orders")
}

// ---------------------------------------------------------------------------
// Loyalty (growth plan Month 11)
// ---------------------------------------------------------------------------

enum LoyaltyTxType {
  earn // a stay's spend, at check-out
  redeem // points turned into a folio payment
  adjust // a manager's correction or goodwill, with a reason

  @@map("loyalty_tx_type_enum")
}

// One programme per tenant — guests are tenant-wide, so a member earns and
// redeems at every branch that charges in the programme's currency.
model LoyaltyProgram {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @unique @db.Uuid
  isActive      Boolean  @default(false)
  currency      String   @db.Char(3)
  pointsPerUnit Decimal  @db.Decimal(10, 4) // points per 1 unit of currency spent before tax — 0.01 = 1 point per ₦100
  pointValue    Decimal  @db.Decimal(12, 4) // what one point is worth when redeemed, in `currency`
  // [{ name, threshold, benefits: string[] }] — threshold = lifetime points; a member holds the highest tier reached
  tiers         Json
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  updatedBy     String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

// The points ledger, append-only. A guest's balance is the sum of their rows.
model LoyaltyTransaction {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @db.Uuid
  guestId           String        @db.Uuid
  branchId          String?       @db.Uuid
  type              LoyaltyTxType
  points            Int // signed: a redemption is negative
  description       String        @db.VarChar(300)
  earnReservationId String?       @unique @db.Uuid // earn rows: one per stay
  paymentId         String?       @unique @db.Uuid // redeem rows: the folio payment they became
  createdBy         String?       @db.Uuid // NULL = earned automatically at check-out
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest       GuestProfile @relation(fields: [guestId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [earnReservationId], references: [id], onDelete: Restrict)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([guestId, createdAt])
  @@map("loyalty_transactions")
}

// ---------------------------------------------------------------------------
// Marketing (Month 11) - campaigns reuse the Comms Log outbound path below:
// a campaign send and a booking confirmation are the same delivery mechanism
// at different volumes, not two systems.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  scheduled
  sending // recipients are still being written - resumable, see MarketingService.sendCampaign
  sent
  cancelled
  failed

  @@map("campaign_status_enum")
}

/**
 * A saved audience definition. `criteria` is re-queried against live
 * guest/reservation/payment data every time the segment is previewed or sent
 * to, so there is no materialised member list to go stale - and no
 * guest-data warehouse, which the growth plan's own note for this month says
 * is unnecessary at this scale.
 * Soft-deleted rather than deleted, so a campaign that already went out
 * keeps the audience it was aimed at.
 */
model GuestSegment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(300)
  // { vipLevelMin?, loyaltyTiers?: string[], tags?: string[], nationalities?: string[], branchIds?: string[],
  //   minStays?, minTotalSpend?, lastStayWithinDays?, notStayedForDays? } - see segment-rules.ts
  criteria    Json
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns MarketingCampaign[]

  @@unique([tenantId, name])
  @@map("guest_segments")
}

/**
 * Subject and body with `{{merge_field}}` placeholders - campaign-render.ts owns the ones that resolve.
 */
model MessageTemplate {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @db.Uuid
  name      String       @db.VarChar(120)
  channel   CommsChannel @default(email)
  subject   String?      @db.VarChar(500)
  body      String
  createdBy String?      @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?    @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns        MarketingCampaign[] @relation("CampaignTemplate")
  variantCampaigns MarketingCampaign[] @relation("CampaignVariantTemplate")

  @@unique([tenantId, name])
  @@map("message_templates")
}

model MarketingCampaign {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @db.Uuid
  branchId          String         @db.Uuid // the sending property: every CommunicationLog row belongs to one
  name              String         @db.VarChar(160)
  channel           CommsChannel
  segmentId         String         @db.Uuid
  templateId        String         @db.Uuid
  subject           String?        @db.VarChar(500) // overrides the template's own subject for this send
  status            CampaignStatus @default(draft)
  scheduledAt       DateTime?      @db.Timestamptz(6)
  sentAt            DateTime?      @db.Timestamptz(6)
  variantTemplateId String?        @db.Uuid // A/B test: variant B's template. NULL = no test
  splitRatio        Decimal?       @db.Decimal(3, 2) // share of recipients who get variant A
  recipientCount    Int            @default(0)
  failureReason     String?        @db.VarChar(500)
  createdBy         String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  segment         GuestSegment        @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  template        MessageTemplate     @relation("CampaignTemplate", fields: [templateId], references: [id], onDelete: Restrict)
  variantTemplate MessageTemplate?    @relation("CampaignVariantTemplate", fields: [variantTemplateId], references: [id], onDelete: Restrict)
  recipients      CampaignRecipient[]

  @@index([tenantId, branchId, status])
  @@index([status, scheduledAt]) // the scheduled-send sweep's own query
  @@map("marketing_campaigns")
}

/**
 * One row per guest a campaign actually went out to, and the only place open
 * and click are recorded. `communicationLogId` is the message itself, so the
 * guest's own comms history and the campaign's performance are one event seen
 * from two sides rather than two copies of it.
 */
model CampaignRecipient {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @db.Uuid
  campaignId         String    @db.Uuid
  guestId            String    @db.Uuid
  variant            String    @db.Char(1) // A | B
  communicationLogId String?   @unique @db.Uuid
  sentAt             DateTime  @default(now()) @db.Timestamptz(6)
  openedAt           DateTime? @db.Timestamptz(6) // first open only - a pixel can be fetched many times
  clickedAt          DateTime? @db.Timestamptz(6)
  unsubscribedAt     DateTime? @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign         MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guest            GuestProfile      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  communicationLog CommunicationLog? @relation(fields: [communicationLogId], references: [id], onDelete: SetNull)

  @@unique([campaignId, guestId]) // one send per guest per campaign - what makes a resumed send idempotent
  @@index([tenantId, campaignId])
  @@map("campaign_recipients")
}

model NightAuditLog {
  id                BigInt           @id @default(autoincrement())
  tenantId          String           @db.Uuid
  branchId          String           @db.Uuid
  auditDate         DateTime         @db.Date // the calendar date being closed (branch timezone)
  triggeredBy       String?          @db.Uuid // NULL = scheduled automatic run
  triggeredAt       DateTime         @default(now()) @db.Timestamptz(6)
  status            NightAuditStatus @default(running) // 'running' older than 10 min = stuck
  foliosProcessed   Int?
  chargesPosted     Int?
  totalAmountPosted Decimal?         @db.Decimal(14, 2)
  errors            Json? // [{folioId, reason}] — continue on error, never abort the batch
  completedAt       DateTime?        @db.Timestamptz(6)

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  triggeredByUser User?  @relation(fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@unique([branchId, auditDate]) // the DB enforces single-run
  @@index([branchId, auditDate(sort: Desc)])
  @@index([status])
  @@map("night_audit_log")
}

// ---------------------------------------------------------------------------
// Comms & Compliance (3)
// ---------------------------------------------------------------------------

model CommunicationLog {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @db.Uuid
  branchId          String         @db.Uuid
  reservationId     String?        @db.Uuid // NULL = marketing / no specific reservation
  guestId           String         @db.Uuid
  channel           CommsChannel
  subject           String?        @db.VarChar(500) // email subject, or a guest request's type ("Late check-out request")
  body              String
  // The HTML a mail client receives, when there is one (marketing campaigns render both).
  // `body` above stays the plain-text version and is what the inbox and the guest history show.
  bodyHtml          String?
  trigger           String         @db.VarChar(50) // booking_confirmation | pre_arrival | checkin_receipt | invoice | post_stay | no_show_notice | cancellation | manual | guest_message | guest_request
  direction         CommsDirection @default(outbound)
  readAt            DateTime?      @db.Timestamptz(6) // inbound only: when staff first read it. NULL = unread
  // Email rows progress via CommsDispatcherService; an in_app_chat reply is 'sent' when written (the guest portal is its
  // transport); inbound rows are 'delivered' (received). sms/push stay 'queued' — no transport yet.
  deliveryStatus    DeliveryStatus @default(queued)
  externalMessageId String?        @db.VarChar(200)
  sentBy            String?        @db.Uuid // NULL = automated system send
  sentAt            DateTime       @default(now()) @db.Timestamptz(6)
  deliveredAt       DateTime?      @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       GuestProfile @relation(fields: [guestId], references: [id], onDelete: Restrict)
  sentByUser  User?        @relation(fields: [sentBy], references: [id], onDelete: SetNull)

  campaignRecipient CampaignRecipient?

  @@index([reservationId, sentAt(sort: Desc)])
  @@index([guestId, sentAt(sort: Desc)])
  @@index([branchId, deliveryStatus, sentAt])
  @@index([branchId, direction, readAt])
  @@map("communication_log")
}

// Append-only staff action ledger. Every state-changing endpoint writes here
// via the AuditInterceptor. Cross-tenant access attempts are logged with
// action prefix 'security.'.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @db.Uuid
  branchId   String?  @db.Uuid
  userId     String?  @db.Uuid // NULL = system action
  action     String   @db.VarChar(100) // e.g. reservation.check_in | folio.charge_posted
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.Uuid
  before     Json? // NULL for CREATE
  after      Json? // NULL for DELETE
  ipAddress  String?  @db.Inet
  userAgent  String? // truncated to 500 chars at write time
  timestamp  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId, timestamp(sort: Desc)])
  @@map("audit_log")
}

model GdprRequest {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @db.Uuid
  guestId     String     @db.Uuid
  type        GdprType
  status      GdprStatus @default(pending)
  requestedBy String     @db.VarChar(320) // email of requester (may not be a system user)
  requestedAt DateTime   @default(now()) @db.Timestamptz(6)
  deadline    DateTime   @db.Date // requestedAt + 30 days
  completedAt DateTime?  @db.Timestamptz(6)
  exportUrl   String? // signed S3 URL, expires after 7 days
  notes       String?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guest  GuestProfile @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("gdpr_requests")
}

// ---------------------------------------------------------------------------
// System (2) — global tables, NOT tenant-scoped (no RLS)
// ---------------------------------------------------------------------------

model FeatureFlag {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @unique @db.VarChar(100) // loyalty_module | overbooking_engine
  enabledGlobally   Boolean  @default(false)
  enabledForTenants String[] @db.Uuid // tenant-specific overrides; empty = use global
  rolloutPct        Int?     @db.SmallInt // 0–100
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  updatedBy         String?  @db.VarChar(200)

  @@map("feature_flags")
}

model BackupRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @db.Uuid // NULL = full-system backup
  type        String    @db.VarChar(20) // full | incremental | schema_only
  status      String    @db.VarChar(20) // running | completed | failed
  storageUrl  String?
  sizeBytes   BigInt?
  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  retainUntil DateTime? @db.Date

  @@index([tenantId])
  @@map("backup_records")
}
