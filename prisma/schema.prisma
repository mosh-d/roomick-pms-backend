  @@map("payment_purpose_enum")
}

enum RefundStatus {
  pending
  approved
  rejected
  processed

  @@map("refund_status_enum")
}

enum PenaltyType {
  first_night
  full_stay
  flat_fee
  none

  @@map("penalty_type_enum")
}

enum OutletCategory {
  restaurant
  bar
  spa
  laundry
  retail
  room_service

  @@map("outlet_category_enum")
}

enum HousekeepingStatus {
  pending
  in_progress
  done
  skipped

  @@map("hk_status_enum")
}

enum ShiftType {
  morning
  evening
  night

  @@map("shift_type_enum")
}

enum IssuePriority {
  low
  medium
  high
  urgent

  @@map("issue_priority_enum")
}

enum IssueStatus {
  open
  resolved
  carried_over

  @@map("issue_status_enum")
}

enum MaintenancePriority {
  low
  medium
  high
  urgent

  @@map("maintenance_priority_enum")
}

enum MaintenanceStatus {
  open
  in_progress
  on_hold
  resolved
  cancelled

  @@map("maintenance_status_enum")
}

enum NightAuditStatus {
