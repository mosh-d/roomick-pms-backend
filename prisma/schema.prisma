// Roomick PMS — Prisma schema (DB architecture v1.2, 39 spec tables + corporate_accounts)
//
// Conventions (see pms-database-architecture.html "Patterns & Rules"):
// - Table names: snake_case plural via @@map. Column names stay camelCase (quoted in PG)
//   so the RLS policy `"tenantId" = current_setting('app.tenant_id')::uuid` reads naturally.
// - UUID v4 PKs everywhere except audit_log / rate_audit_log / night_audit_log (BIGSERIAL).
// - Money is NUMERIC(12,2). Dates without time are DATE. All timestamps TIMESTAMPTZ.
// - Soft delete (`deletedAt`) on: guests, reservations, folios, line_items, payments,
//   room_types, rooms, users (+ brands/branches per DB doc).
// - RLS is applied in a hand-written migration (see prisma/migrations/*_rls); Prisma does
//   not model policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BrandMode {
  single
  multi

  @@map("brand_mode_enum")
}

