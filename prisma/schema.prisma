  @@map("gdpr_status_enum")
}

// ---------------------------------------------------------------------------
// Identity & Auth (5)
// ---------------------------------------------------------------------------

model Tenant {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Backend-internal identifier only — auto-generated at registration
  // (slugified groupName, retried with a random suffix on collision, see
  // AuthService.register), never user-typed or shown. Login no longer
  // uses it at all (see UserEmailIndex below); nothing else in the app
  // consumes it as a real subdomain/URL either.
  subdomain     String       @unique @db.VarChar(63)
  groupName     String       @db.VarChar(200)
  brandMode     BrandMode
  status        TenantStatus @default(trial)
  trialEndsAt   DateTime?    @db.Timestamptz(6)
  // Owner-supplied country at signup (ISO 3166-1 alpha-2, e.g. "NG") —
  // reporting/analytics only for now (which countries onboard from), not
  // consumed by any business logic yet. Optional: not every signup is
  // guaranteed to supply it.
  country       String?      @db.VarChar(2)
  // Demo tenants (self-serve "try it" signups, not a sales-assisted trial):
  // auto-expire and get swept by a scheduled job (see
  // TenantsService.deleteOrganization / the demo-cleanup cron), or a user
  // can trigger the same deletion early via DELETE /tenants/:id. Real
  // tenants never set these.
  isDemo        Boolean      @default(false)
  demoExpiresAt DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  users                    User[]
  roles                    Role[]
  userBranchRoles          UserBranchRole[]
  inviteTokens             InviteToken[]
  brands                   Brand[]
  branches                 Branch[]
  buildings                Building[]
  floors                   Floor[]
  roomTypes                RoomType[]
  rooms                    Room[]
  roomBlocks               RoomBlock[]
  guestProfiles            GuestProfile[]
  reservations             Reservation[]
  ratePlans                RatePlan[]
  rateAuditLogs            RateAuditLog[]
  noShowRecords            NoShowRecord[]
  walkRecords              WalkRecord[]
  corporateAccounts        CorporateAccount[]
  folios                   Folio[]
  lineItems                LineItem[]
  folioTransfers           FolioTransfer[]
  payments                 Payment[]
  refunds                  Refund[]
  taxRules                 TaxRule[]
  housekeepingTasks        HousekeepingTask[]
  shifts                   Shift[]
  shiftIssues              ShiftIssue[]
  maintenanceOrders        MaintenanceOrder[]
  assets                   Asset[]
  registrationCards        RegistrationCard[]
  overbookingConfig        OverbookingConfig[]
  outlets                  Outlet[]
  userOutlets              UserOutlet[]
  nightAuditLogs           NightAuditLog[]
  communicationLogs        CommunicationLog[]
  auditLogs                AuditLog[]
  gdprRequests             GdprRequest[]
  guestNotes               GuestNote[]
  apiKeys                  ApiKey[]
  webhooks                 Webhook[]
  groupBlocks              GroupBlock[]
  eventSpaces              EventSpace[]
  eventBookings            EventBooking[]
  availabilityRestrictions AvailabilityRestriction[]
  menuItems                MenuItem[]
  posOrders                PosOrder[]
  competitors              Competitor[]
  competitorRates          CompetitorRate[]
  loyaltyProgram           LoyaltyProgram?
  loyaltyTransactions      LoyaltyTransaction[]
  guestSegments            GuestSegment[]
  messageTemplates         MessageTemplate[]
  marketingCampaigns       MarketingCampaign[]
  campaignRecipients       CampaignRecipient[]
  integrationConnections   IntegrationConnection[]

  @@index([isDemo, demoExpiresAt])
  @@map("tenants")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  email         String    @db.VarChar(320)
  passwordHash  String?   @db.VarChar(72)
  name          String    @db.VarChar(200)
  phone         String?   @db.VarChar(20)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  branchRoles                UserBranchRole[]    @relation("UserBranchRoleUser")
  branchRolesAssigned        UserBranchRole[]    @relation("UserBranchRoleAssignedBy")
  inviteTokensSent           InviteToken[]
  roomsStatusChanged         Room[]
  roomBlocksCreated          RoomBlock[]
  reservationsCreated        Reservation[]
  rateAuditLogs              RateAuditLog[]
  noShowsWaived              NoShowRecord[]      @relation("NoShowWaivedBy")
  noShowsMarked              NoShowRecord[]      @relation("NoShowMarkedBy")
  walkRecordsApproved        WalkRecord[]
  lineItemsPosted            LineItem[]          @relation("LineItemPostedBy")
  lineItemsVoided            LineItem[]          @relation("LineItemVoidedBy")
  folioTransfersApproved     FolioTransfer[]     @relation("TransferApprovedBy")
  folioTransfersReversed     FolioTransfer[]     @relation("TransferReversedBy")
  paymentsRecorded           Payment[]           @relation("PaymentRecordedBy")
  paymentsVoided             Payment[]           @relation("PaymentVoidedBy")
  refundsRequested           Refund[]            @relation("RefundRequestedBy")
  refundsApproved            Refund[]            @relation("RefundApprovedBy")
  housekeepingTasksAssigned  HousekeepingTask[]  @relation("HkAssignee")
  housekeepingTasksCompleted HousekeepingTask[]  @relation("HkCompletedBy")
  shifts                     Shift[]
  shiftIssuesResolved        ShiftIssue[]
  maintenanceOrdersReported  MaintenanceOrder[]  @relation("MaintReportedBy")
  maintenanceOrdersAssigned  MaintenanceOrder[]  @relation("MaintAssignedTo")
  registrationCardsWitnessed RegistrationCard[]
  overbookingConfigsUpdated  OverbookingConfig[]
  outletAssignments          UserOutlet[]        @relation("UserOutletUser")
  outletAssignmentsMade      UserOutlet[]        @relation("UserOutletAssignedBy")
  nightAuditsTriggered       NightAuditLog[]
  communicationsSent         CommunicationLog[]
  auditLogs                  AuditLog[]
  guestNotesAuthored         GuestNote[]

  // Global, not per-tenant: login is plain email+password now (no
  // subdomain/tenant header to disambiguate), so one email can only ever
  // resolve to one account. Real behavior change from the old
  // @@unique([tenantId, email]) — the same address can no longer be staff
  // at two independent tenants (see UserEmailIndex below and
  // AuthService.acceptInvite's cross-tenant guard).
  @@unique([email])
  @@index([tenantId, deletedAt])
  @@map("users")
}

/**
 * Deliberately NOT RLS-scoped — same category as `Tenant`/`FeatureFlag`/
 * `BackupRecord` (system-level, not per-tenant data). Exists because
 * `users` has FORCE ROW LEVEL SECURITY (`tenant_isolation` policy,
 * `USING ("tenantId" = current_setting('app.tenant_id', true)::uuid)`):
 * a query against `users` with no `app.tenant_id` set (i.e. before you
 * know which tenant to even look in) returns zero rows, always — verified
 * directly, not assumed. Login needs exactly this "which tenant does this
 * email belong to" answer *before* it can call `withTenant()`, so this
 * table exists purely to answer that one question, holding nothing more
 * sensitive than the pointer itself: no passwordHash, no name, no phone.
 * Every real user field still lives only on the RLS-protected `users` row.
 */
model UserEmailIndex {
  email     String   @id @db.VarChar(320)
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
  @@map("user_email_index")
}

/**
 * Deliberately NOT RLS-scoped, for exactly the same reason as
 * `UserEmailIndex` above: `branches` has FORCE ROW LEVEL SECURITY, so a
 * lookup by public booking slug — which arrives on a completely
 * unauthenticated request, before any tenant is known — would return zero
 * rows against `branches` itself. This table answers only "which
 * tenant/branch does this public slug point at", holding nothing more
 * sensitive than that pointer.
 * A row exists ONLY while a branch is actually published to the booking
 * engine: publishing upserts it, unpublishing (or changing the slug)
 * deletes it. An unresolvable slug is therefore indistinguishable from a
 * never-existent one, which is the correct public behavior.
 * The pointer is never trusted on its own — `PublicBookingService` always
 * re-loads the real branch inside `withTenant` and re-checks
 * `bookingEngineEnabled`/`deletedAt` plus the owning tenant's status before
 * serving anything.
 */
model BookingSlugIndex {
  slug      String   @id @db.VarChar(63)
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([branchId])
  @@map("booking_slug_index")
}

/**
 * Pre-auth lookup for the three links inside a marketing email - the open
 * pixel, the click redirect and the unsubscribe page. Same category and the
 * same reasoning as `BookingSlugIndex` above: those requests arrive from a
 * mail client with no session and no tenant header, and `campaign_recipients`
 * has FORCE ROW LEVEL SECURITY, so its row cannot be found without knowing
 * the tenant first.
 * It holds the opaque token and the two ids it points at and nothing else -
 * no address, no name, no campaign content. `MarketingService` re-loads the
 * real recipient inside withTenant() before recording anything, exactly as
 * PublicBookingService re-loads the branch behind a slug.
 */
model MarketingTokenIndex {
  token       String   @id @db.VarChar(64)
  tenantId    String   @db.Uuid
  recipientId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([recipientId])
  @@map("marketing_token_index")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @db.Uuid
  name        String  @db.VarChar(100)
  isSystem    Boolean @default(false)
  permissions Json? // {module: [actions]} — PUT /auth/roles/:roleId/permissions; NULL = role-name defaults

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userBranchRoles UserBranchRole[]
  inviteTokens    InviteToken[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserBranchRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  branchId   String?  @db.Uuid // NULL = access to all branches (owner/admin)
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  assignedBy String?  @db.Uuid

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User    @relation("UserBranchRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedByUser User?   @relation("UserBranchRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([userId, branchId])
  @@map("user_branch_roles")
}

model InviteToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  email      String    @db.VarChar(320)
  token      String    @unique @db.VarChar(128)
  roleId     String    @db.Uuid
  branchId   String?   @db.Uuid // NULL = all branches
  invitedBy  String?   @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(6)
  acceptedAt DateTime? @db.Timestamptz(6) // NULL = pending
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch        Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invitedByUser User?   @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invite_tokens")
}

// ---------------------------------------------------------------------------
// Property (7)
// ---------------------------------------------------------------------------

model Brand {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  name            String    @db.VarChar(200)
  logoUrl         String?
  primaryColor    String?   @db.VarChar(7)
  defaultPolicies Json?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branches Branch[]

  @@index([tenantId, deletedAt])
  @@map("brands")
}

model Branch {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  brandId            String   @db.Uuid
  name               String   @db.VarChar(200)
  address            Json // {street, city, state, country, zip}
  timezone           String   @db.VarChar(50) // IANA tz — night audit depends on it
  currency           String   @db.Char(3) // ISO 4217
  checkInTime        DateTime @default(dbgenerated("'14:00:00'::time")) @db.Time(0)
  checkOutTime       DateTime @default(dbgenerated("'11:00:00'::time")) @db.Time(0)
  category           String?  @db.VarChar(30) // hotel | resort | motel | boutique | hostel
  policies           Json? // overrides brand defaultPolicies; merged at read time. Holds idCaptureMandatory, early/late surcharge policy, AR flag rules.
  noShowPolicy       Json? // {cutoffTime, defaultPenalty, flatFeeAmount, autoMark, notifyMinutesBefore}
  // {freeCancellationHours, lateCancellationPenalty, flatFeeAmount, allowOnlineCancellation}.
  // NULL = the standard default (free until 24h before check-in, first night after) — see reservations/policies.ts.
  cancellationPolicy Json?
  regCardTemplate    Json? // {logoUrl, houseRules, requiredFields, showRate, language}

  // --- Direct Booking Engine (Month 7) -------------------------------------
  // The public, guest-facing identity of this property. `Tenant.subdomain` is
  // deliberately NOT reused: its own schema comment marks it backend-internal
  // ("never user-typed or shown"), it can carry a random hex collision
  // suffix, and a booking URL identifies a PROPERTY, not the tenant group
  // that owns it — a group with five hotels needs five distinct booking
  // pages, not one.
  //
  // Both fields are opt-in by default (NULL slug, disabled): an existing
  // branch accepts no public bookings until its owner explicitly publishes
  // it, so this migration changes no existing behavior. They're kept
  // separate rather than folded into "non-null slug means published" so a
  // property can be unpublished temporarily without releasing its slug for
  // someone else to claim.
  bookingSlug          String? @unique @db.VarChar(63)
  bookingEngineEnabled Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  userBranchRoles          UserBranchRole[]
  inviteTokens             InviteToken[]
  buildings                Building[]
  roomTypes                RoomType[]
  rooms                    Room[]
  reservations             Reservation[]
  ratePlans                RatePlan[]
  rateAuditLogs            RateAuditLog[]
  folios                   Folio[]
  taxRules                 TaxRule[]
  housekeepingTasks        HousekeepingTask[]
  shifts                   Shift[]
  maintenanceOrders        MaintenanceOrder[]
  assets                   Asset[]
  registrationCards        RegistrationCard[]
  overbookingConfig        OverbookingConfig[]
  outlets                  Outlet[]
  userOutlets              UserOutlet[]
  nightAuditLogs           NightAuditLog[]
  communicationLogs        CommunicationLog[]
  auditLogs                AuditLog[]
  groupBlocks              GroupBlock[]
  eventSpaces              EventSpace[]
  availabilityRestrictions AvailabilityRestriction[]
  menuItems                MenuItem[]
  posOrders                PosOrder[]
  competitors              Competitor[]
  loyaltyTransactions      LoyaltyTransaction[]
  marketingCampaigns       MarketingCampaign[]

  @@index([tenantId, brandId])
  @@index([tenantId, deletedAt])
  @@map("branches")
}

model Building {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String?  @db.VarChar(100) // NULL = hidden auto-created default (onboarding skipped this level)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  floors Floor[]

  @@index([branchId])
  @@map("buildings")
}

model Floor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  buildingId  String   @db.Uuid
  floorNumber Int // 0 = ground floor
  label       String?  @db.VarChar(30) // NULL = hidden auto-created default
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  rooms Room[]

  @@index([buildingId])
  @@map("floors")
}

model RoomType {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String    @db.Uuid
  name      String    @db.VarChar(100)
  baseRate  Decimal   @db.Decimal(12, 2) // starting point for the Rate Resolver — always > 0. NOT in rate_plans.
  capacity  Json // {adults: int, children: int}
  bedType   String?   @db.VarChar(50)
  sizeM2    Decimal?  @db.Decimal(6, 1)
  amenities String[]
  photoUrls String[]
  sortOrder Int?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  rooms                    Room[]
  reservations             Reservation[]
  ratePlans                RatePlan[]
  overbookingConfig        OverbookingConfig[]
  groupBlocks              GroupBlock[]
  availabilityRestrictions AvailabilityRestriction[]
  competitorRates          CompetitorRate[]

  @@index([branchId, deletedAt])
  @@map("room_types")
}

model Room {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @db.Uuid
  branchId          String            @db.Uuid
  roomTypeId        String            @db.Uuid
  floorId           String            @db.Uuid
  number            String            @db.VarChar(20)
  // Three independent status axes (schema v1.1) — never recombine into one column.
  occupancyStatus   OccupancyStatus   @default(vacant)
  cleanlinessStatus CleanlinessStatus @default(clean)
  heldStatus        HeldStatus? // NULL = normal; non-NULL removes room from all availability
  view              String?           @db.VarChar(50)
  notes             String?
  statusChangedAt   DateTime?         @db.Timestamptz(6)
  statusChangedBy   String?           @db.Uuid // NULL = system trigger
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?         @db.Timestamptz(6)

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType            RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  floor               Floor    @relation(fields: [floorId], references: [id], onDelete: Restrict)
  statusChangedByUser User?    @relation(fields: [statusChangedBy], references: [id], onDelete: SetNull)

  roomBlocks        RoomBlock[]
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  maintenanceOrders MaintenanceOrder[]
  assets            Asset[]

  @@unique([branchId, number])
  @@index([branchId, occupancyStatus, cleanlinessStatus])
  @@index([branchId, roomTypeId, occupancyStatus])
  @@index([branchId, cleanlinessStatus])
  @@index([floorId, cleanlinessStatus])
  @@map("rooms")
}

model RoomBlock {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String      @db.Uuid
  roomId    String      @db.Uuid
  reason    BlockReason
  fromDate  DateTime    @db.Date
  toDate    DateTime    @db.Date
  notes     String?
  createdBy String?     @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([roomId, fromDate, toDate])
  @@map("room_blocks")
}

// ---------------------------------------------------------------------------
// Reservations (6) + Corporate
// ---------------------------------------------------------------------------

model GuestProfile {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @db.Uuid
  name                    String    @db.VarChar(200)
  email                   String?   @db.VarChar(320)
  phone                   String?   @db.VarChar(20)
  nationality             String?   @db.Char(2) // ISO 3166-1 alpha-2
  idDocType               String?   @db.VarChar(30) // passport | national_id | drivers_license
  idDocNumber             String? // AES-256-GCM encrypted at application layer — never plaintext
  idDocUrl                String? // encrypted S3 bucket URL
  idDocExpiryDate         DateTime? @db.Date // drives 3-state check-in logic: first_visit | valid | expired
  preferences             Json? // {bedType, floor, view, pillow, temp, dietaryRestrictions[]}
  vipLevel                Int?      @default(0) @db.SmallInt // 0–5
  tags                    String[]
  notes                   String?
  loyaltyTier             String?   @db.VarChar(30)
  loyaltyPoints           Int?      @default(0) // the balance — a copy of the sum of the guest's loyalty_transactions, kept in the same transaction as each row
  loyaltyEnrolledAt       DateTime? @db.Timestamptz(6) // NULL = not a member of the loyalty programme
  // Marketing consent. No campaign ever reaches a guest without an explicit opt-in, and
  // `marketingUnsubscribedAt` is kept after an opt-out as the record of when they withdrew it.
  marketingOptIn          Boolean   @default(false)
  marketingOptInAt        DateTime? @db.Timestamptz(6)
  marketingOptInSource    String?   @db.VarChar(30) // booking_engine | guest_portal | front_desk
  marketingUnsubscribedAt DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6) // GDPR erasure sets deletedAt + nullifies PII

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservations        Reservation[]
  folios              Folio[]
  registrationCards   RegistrationCard[]
  communicationLogs   CommunicationLog[]
  gdprRequests        GdprRequest[]
  guestNotes          GuestNote[]
  loyaltyTransactions LoyaltyTransaction[]
  campaignRecipients  CampaignRecipient[]

  @@index([tenantId, email])
  @@index([tenantId, name])
  @@map("guest_profiles")
}

/**
 * The CRM's own "Notes feed" (architecture map, `page-guestprofile`) —
 * `GuestProfile.notes` is a single overwritable `String?` (a legacy field
 * from the original create-guest pass), not a chronological log. This is
 * append-only, same ledger discipline `AuditLog`/`FoliosService.correctLineItem`
 * already hold to elsewhere: no update, no delete, just a growing record of
 * who said what and when.
 */
model GuestNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  guestId   String   @db.Uuid
  authorId  String?  @db.Uuid // NULL = system-authored
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  GuestProfile @relation(fields: [guestId], references: [id], onDelete: Cascade)
  author User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([guestId, createdAt])
  @@map("guest_notes")
}

/**
 * Integrations & APIs' own "API Keys" card. The raw key is shown to the
 * caller exactly once, at creation — only `keyHash` (SHA-256; the key
 * itself is high-entropy random data, not a user-chosen password, so a
 * slow KDF like bcrypt buys nothing here) and `keyPrefix` (for on-screen
 * identification in a list) are ever persisted. Not yet consumed by any
 * authentication path in this app — see `IntegrationsService`'s own header
 * comment for why that's a deliberate, stated limitation, not an oversight.
 */
model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  name       String    @db.VarChar(200)
  keyPrefix  String    @db.VarChar(12)
  keyHash    String    @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  createdBy  String?   @db.Uuid
  lastUsedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/**
 * Integrations & APIs' own "Webhooks" card — subscription definitions
 * only. `secret` (for signing a delivered payload) is shown once at
 * creation, same discipline as `ApiKey`'s own raw key. Not yet triggered by
 * any real PMS event — delivery infrastructure (matching subscriptions
 * against an event, POSTing, retry/backoff) is real, cross-cutting
 * infrastructure work this pass deliberately doesn't take on; see
 * `IntegrationsService`'s own header comment.
 */
model Webhook {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  url        String   @db.VarChar(500)
  eventTypes String[]
  secret     String   @db.VarChar(64)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhooks")
}

enum IntegrationStatus {
  enabled
  disabled

  @@map("integration_status_enum")
}

/**
 * The Integrations Marketplace's per-tenant state (Month 11). One row per
 * connector a tenant has ever switched on; the catalogue itself — names,
 * categories, what each connector does — lives in code
 * (`marketplace-catalog.ts`), because a listing is only real if code exists
 * behind it.
 * `config` is validated by the connector's own parser on every write AND
 * every read, so a hand-edited row can't make an export or a scheduled job
 * do something nobody configured. Disabling keeps the configuration, so
 * switching back on doesn't mean re-entering an account map.
 * Nothing here is secret; a connector that needs credentials stores them
 * encrypted, and none of the current ones does.
 */
model IntegrationConnection {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @db.Uuid
  provider       String            @db.VarChar(50) // catalogue key: quickbooks_online | xero | review_requests
  status         IntegrationStatus @default(enabled)
  config         Json
  enabledAt      DateTime          @default(now()) @db.Timestamptz(6) // the latest time it was switched on
  enabledBy      String?           @db.Uuid
  disabledAt     DateTime?         @db.Timestamptz(6)
  lastRunAt      DateTime?         @db.Timestamptz(6)
  lastRunSummary String?           @db.VarChar(500)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  updatedBy      String?           @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([provider, status]) // the review-request sweep's own lookup
  @@map("integration_connections")
}

/**
 * Sales & Events' own "Group Block Creation" card. Deliberately does NOT
 * invent a parallel rate mechanism — a reservation booked against a block
 * gets the block's own `blockRate` applied through the SAME `Reservation
 * .overrideRate`/`overrideReason` fields (and the same `setRateOverride`
 * method) Manager Dashboard's own Rate Override already uses, just called
 * from `GroupBlocksService` instead of a controller. Pickup is a computed
 * count of `Reservation`s with this `groupBlockId`, never a stored counter
 * that could drift from reality.
 */
model GroupBlock {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String    @db.Uuid
  roomTypeId    String    @db.Uuid
  name          String    @db.VarChar(200)
  blockSize     Int
  blockRate     Decimal   @db.Decimal(12, 2)
  cutoffDate    DateTime  @db.Date
  status        String    @default("active") @db.VarChar(20) // active | released | cancelled
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  // The group's stay. While the cut-off hasn't passed, every night in
  // [arrivalDate, departureDate) holds `blockSize` minus the block's own
  // bookings out of general availability; past the cut-off the hold lapses
  // on its own. NULL on blocks made before holds existed — those hold nothing.
  arrivalDate   DateTime? @db.Date
  departureDate DateTime? @db.Date
  contactName   String?   @db.VarChar(200)
  contactEmail  String?   @db.VarChar(320)
  contactPhone  String?   @db.VarChar(30)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([tenantId, branchId])
  @@index([branchId, roomTypeId, status])
  @@map("group_blocks")
}

/**
 * Revenue Management's own "Restrictions Management" card (ref: "MinLOS,
 * CTA, MaxLOS, stop-sell"). Deliberately a DIFFERENT concept from `RatePlan
 * .minLOS` — that field decides which rate-cascade TIER applies for a
 * given stay length, never rejects a booking outright. This model is a
 * genuine, date-ranged, hard availability restriction, enforced as an
 * additive check in `ReservationsService.createReservation` (a tenant that
 * never configures one sees zero behavior change).
 */
model AvailabilityRestriction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  branchId        String   @db.Uuid
  roomTypeId      String?  @db.Uuid // NULL = applies to every room type at the branch
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date // exclusive, matching this codebase's own date-range convention
  minLOS          Int?     @db.SmallInt
  maxLOS          Int?     @db.SmallInt
  closedToArrival Boolean  @default(false)
  stopSell        Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdBy       String?  @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, startDate, endDate])
  @@map("availability_restrictions")
}

/**
 * Sales & Events' own "Event Space Calendar" card — a bookable, non-guestroom venue. Deliberately its own model, not a `Room`: a ballroom has no occupancy/cleanliness status and is booked by time range, not by night.
 */
model EventSpace {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  branchId        String   @db.Uuid
  name            String   @db.VarChar(200)
  category        String   @db.VarChar(20) // meeting_room | ballroom | outdoor
  capacity        Int
  // Seats per layout — { theater?, classroom?, banquet?, u_shape? }. A layout
  // left out falls back to `capacity`.
  setupCapacities Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings EventBooking[]

  @@index([tenantId, branchId])
  @@map("event_spaces")
}

model EventBooking {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  eventSpaceId   String   @db.Uuid
  title          String   @db.VarChar(200)
  startsAt       DateTime @db.Timestamptz(6)
  endsAt         DateTime @db.Timestamptz(6)
  contactName    String?  @db.VarChar(200)
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  createdBy      String?  @db.Uuid
  // The Banquet Event Order's details.
  setupStyle     String?  @db.VarChar(20) // theater | classroom | banquet | u_shape
  headcount      Int? // guaranteed numbers, checked against the space's capacity for the layout
  contactEmail   String?  @db.VarChar(320)
  contactPhone   String?  @db.VarChar(30)
  catering       Json? // [{ description, quantity, unitPrice }] — totals are computed, never stored
  avRequirements String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventSpace EventSpace @relation(fields: [eventSpaceId], references: [id], onDelete: Cascade)

  @@index([eventSpaceId, startsAt])
  @@map("event_bookings")
}

// ---------------------------------------------------------------------------
// Revenue Management — comp set (growth plan Month 8)
// ---------------------------------------------------------------------------

// A hotel the property prices itself against. Rates are entered by hand; a
// paid rate-shopping feed would write the same `competitor_rates` rows later.
model Competitor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) // inactive = out of the comp set, rates kept
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rates  CompetitorRate[]

  @@index([branchId])
  @@map("competitors")
}

// One competitor's nightly rate for a date, against one of OUR room types —
// the room they sell that's comparable. Re-entering a date replaces it.
model CompetitorRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  competitorId String   @db.Uuid
  roomTypeId   String   @db.Uuid
  stayDate     DateTime @db.Date
  rate         Decimal  @db.Decimal(12, 2)
  enteredBy    String?  @db.Uuid
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([competitorId, roomTypeId, stayDate])
  @@index([roomTypeId, stayDate])
  @@map("competitor_rates")
}

model Reservation {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  confirmationNumber    String             @db.VarChar(20) // RES-2024-00001, sequence per branch — unique per tenant, see @@unique below
  tenantId              String             @db.Uuid
  branchId              String             @db.Uuid
  guestId               String             @db.Uuid
  roomTypeId            String             @db.Uuid
  roomId                String?            @db.Uuid // NULL until check-in (or assignment); always NULL while waitlisted
  ratePlanId            String?            @db.Uuid // plan that won at booking time
  confirmedRate         Decimal            @db.Decimal(12, 2) // snapshot at booking — never changes
  overrideRate          Decimal?           @db.Decimal(12, 2) // manager rate override (absolute nightly rate) — NOT a rate_plans row
  overrideReason        String? // mandatory when overrideRate is set
  groupBlockId          String?            @db.Uuid // NULL = not booked against a group block; the block's own rate is applied via the SAME overrideRate mechanism, not a parallel one
  status                ReservationStatus  @default(confirmed)
  channel               ReservationChannel
  checkInDate           DateTime           @db.Date
  checkOutDate          DateTime           @db.Date
  actualCheckIn         DateTime?          @db.Timestamptz(6)
  actualCheckOut        DateTime?          @db.Timestamptz(6)
  adults                Int                @db.SmallInt
  children              Int                @default(0) @db.SmallInt
  specialRequests       String?
  depositAmount         Decimal?           @db.Decimal(12, 2)
  createdBy             String?            @db.Uuid // NULL = online booking
  // --- Guest pre-arrival check-in (Month 9) --------------------------------
  // Filled by the guest themselves through the public booking engine's
  // "Manage your booking" page, before they ever reach the desk, so check-in
  // becomes confirm-and-assign rather than a data-entry session.
  //
  // All nullable and unset by default: a reservation nobody pre-checks in
  // behaves exactly as before. Corrected contact details are written to the
  // guest's own `GuestProfile` rather than duplicated here, which means the
  // registration card generated at check-in picks them up automatically —
  // it snapshots the guest record at that moment (see
  // RegistrationCardsService.generateCardInTx).
  preArrivalCompletedAt DateTime?          @db.Timestamptz(6)
  // Guest's own estimate, as HH:mm in the BRANCH's timezone. Stored as text,
  // not a timestamp: it's a stated intention for the arrival date, not an
  // instant, and turning it into one would imply a precision the guest never
  // gave.
  estimatedArrivalTime  String?            @db.VarChar(5)
  houseRulesAcceptedAt  DateTime?          @db.Timestamptz(6)
  // The branch's cancellation policy as it stood when this booking was made —
  // the terms that apply to it, however the branch's policy changes later.
  // NULL for bookings made before snapshots existed (they use the branch's
  // current policy). See reservations/policies.ts.
  cancellationPolicy    Json?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6) // soft delete only — cancelled reservations stay

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  guest         GuestProfile @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomType      RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratePlan      RatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  groupBlock    GroupBlock?  @relation(fields: [groupBlockId], references: [id], onDelete: SetNull)

  rateAuditLogs              RateAuditLog[]
  noShowRecords              NoShowRecord[]
  walkRecords                WalkRecord[]
  folios                     Folio[]
  housekeepingTasksTriggered HousekeepingTask[]
  registrationCards          RegistrationCard[]
  communicationLogs          CommunicationLog[]
  posOrders                  PosOrder[]
  loyaltyTransaction         LoyaltyTransaction?

  @@unique([tenantId, confirmationNumber])
  @@index([branchId, checkInDate, status])
  @@index([branchId, checkOutDate, status])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([guestId])
  @@index([branchId, status, checkInDate])
  @@index([groupBlockId])
  @@map("reservations")
}

model RatePlan {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @db.Uuid
  branchId       String          @db.Uuid
  roomTypeId     String?         @db.Uuid // NULL = applies to all types
  name           String          @db.VarChar(150)
  type           RateType // base/seasonal/weekend/corporate = cascade tiers; negotiated/promotional = overrides
  amount         Decimal         @db.Decimal(12, 2) // cascade tiers: adjustment on running total; overrides: absolute replacement
  adjustmentType AdjustmentType? // fixed | percentage; NULL = absolute (override types only)
  cascadeTier    Int             @db.SmallInt // 1=base 2=seasonal 3=weekend 4=corporate; ignored when isOverride
  isOverride     Boolean         @default(false) // TRUE only for negotiated/promotional — resolver skips cascade entirely
  validFrom      DateTime?       @db.Date // NULL = always valid
  validTo        DateTime?       @db.Date
  minLOS         Int?            @db.SmallInt
  promoCode      String?         @db.VarChar(30) // NULL unless type = promotional
  isActive       Boolean         @default(true) // toggle instead of delete
  outletId       String?         @db.Uuid // reserved for future F&B package pricing
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  outlet   Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)

  reservations      Reservation[]
  corporateAccounts CorporateAccount[]

  @@index([branchId, roomTypeId, isOverride, cascadeTier])
  @@index([branchId, validFrom, validTo])
  @@index([branchId, isOverride])
  @@map("rate_plans")
}

model RateAuditLog {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @db.Uuid
  branchId      String   @db.Uuid
  reservationId String?  @db.Uuid // NULL during pre-booking calculation
  input         Json // full resolver request payload
  result        Json // full cascade trace: {finalRate, isOverride, overrideRatePlanId, cascade:[{tier, ratePlanId, amountBefore, adjustment, amountAfter}]}
  triggeredBy   String?  @db.VarChar(30) // checkin | booking_create | override | ota_import | walkin | modify | extend_stay
  userId        String?  @db.Uuid // NULL = automated
  resolvedAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@map("rate_audit_log")
}

model NoShowRecord {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @db.Uuid
  reservationId String      @db.Uuid
  penaltyType   PenaltyType
  penaltyAmount Decimal?    @db.Decimal(12, 2)
  penaltyWaived Boolean     @default(false)
  waivedBy      String?     @db.Uuid
  refundAmount  Decimal?    @db.Decimal(12, 2)
  markedAt      DateTime    @default(now()) @db.Timestamptz(6)
  markedBy      String?     @db.Uuid // NULL = auto-marked by night audit

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation  Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  waivedByUser User?       @relation("NoShowWaivedBy", fields: [waivedBy], references: [id], onDelete: SetNull)
  markedByUser User?       @relation("NoShowMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@map("no_show_records")
}

model WalkRecord {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @db.Uuid
  reservationId       String   @db.Uuid
  relocationProperty  String   @db.VarChar(200)
  transportProvided   Boolean  @default(false)
  transportCost       Decimal? @db.Decimal(12, 2)
  compensationOffered String?
  approvedBy          String?  @db.Uuid // manager approval required
  walkedAt            DateTime @default(now()) @db.Timestamptz(6)

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  approvedByUser User?       @relation(fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@map("walk_records")
}

// Not in the 39-table count but referenced by folios.corporateAccountId and the
// corporate module (email-domain matcher feeding the corporate cascade tier).
model CorporateAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  name         String   @db.VarChar(200)
  emailDomains String[] // guest email domain match auto-activates the corporate tier / negotiated override
  ratePlanId   String?  @db.Uuid // negotiated agreement plan
  contactName  String?  @db.VarChar(200)
  contactEmail String?  @db.VarChar(320)
  billingInfo  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  folios Folio[]

  @@index([tenantId, isActive])
  @@map("corporate_accounts")
}

// ---------------------------------------------------------------------------
// Financial (6)
// ---------------------------------------------------------------------------

model Folio {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @db.Uuid
  branchId           String      @db.Uuid
  reservationId      String      @db.Uuid
  guestId            String      @db.Uuid
  label              String?     @db.VarChar(100) // NULL = primary folio
  status             FolioStatus @default(pending)
  payerName          String?     @db.VarChar(200)
  payerEmail         String?     @db.VarChar(320)
  corporateAccountId String?     @db.Uuid // NULL = individual folio
  openedAt           DateTime?   @db.Timestamptz(6) // set on check-in
  closedAt           DateTime?   @db.Timestamptz(6) // set on check-out or manual close
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?   @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation      Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest            GuestProfile      @relation(fields: [guestId], references: [id], onDelete: Restrict)
  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)

  lineItems    LineItem[]
  transfersOut FolioTransfer[] @relation("TransferSource")
  transfersIn  FolioTransfer[] @relation("TransferTarget")
  payments     Payment[]
  refunds      Refund[]
  posOrders    PosOrder[]

  @@index([reservationId])
  @@index([branchId, status])
  @@map("folios")
}

// Append-only: no UPDATE of amounts, no DELETE. Corrections = new negative line item.
model LineItem {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @db.Uuid
  folioId            String     @db.Uuid
  description        String     @db.VarChar(300)
  amount             Decimal    @db.Decimal(12, 2) // negative = credit/correction; CHECK (amount != 0) in migration
  taxAmount          Decimal    @default(0) @db.Decimal(12, 2)
  chargeType         ChargeType // NO deposit — deposits are payments
  outletId           String?    @db.Uuid // NULL for room / night-audit / system posts
  taxRuleIds         String[]   @db.Uuid
  serviceDate        DateTime?  @db.Date // date the service occurred (e.g. room-night date)
  postedBy           String?    @db.Uuid // NULL = system-posted (night audit)
  postedAt           DateTime   @default(now()) @db.Timestamptz(6)
  isVoid             Boolean    @default(false) // voided but retained in ledger
  voidedAt           DateTime?  @db.Timestamptz(6)
  voidedBy           String?    @db.Uuid
  deletedAt          DateTime?  @db.Timestamptz(6) // display suppression only, never financial calculation
  // Tax lines only: the charge this tax was computed on. Lets a correction
  // reverse a charge's tax with it, and lets a split move tax with its charge.
  // NULL on charges, and on any tax line posted before this link existed.
  parentLineItemId   String?    @db.Uuid
  // Reversal lines only: the line this reverses. Unique — a line can be
  // corrected once; a second correction would reverse the charge (and now
  // its tax) twice.
  correctsLineItemId String?    @unique @db.Uuid

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  folio        Folio   @relation(fields: [folioId], references: [id], onDelete: Restrict)
  outlet       Outlet? @relation(fields: [outletId], references: [id], onDelete: Restrict)
  postedByUser User?   @relation("LineItemPostedBy", fields: [postedBy], references: [id], onDelete: SetNull)
  voidedByUser User?   @relation("LineItemVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)

  parentLineItem   LineItem?  @relation("TaxOfCharge", fields: [parentLineItemId], references: [id], onDelete: Restrict)
  taxLines         LineItem[] @relation("TaxOfCharge")
  correctsLineItem LineItem?  @relation("CorrectionOf", fields: [correctsLineItemId], references: [id], onDelete: Restrict)
  correctedBy      LineItem?  @relation("CorrectionOf")
  posOrder         PosOrder?

  @@index([parentLineItemId])
  @@index([folioId, postedAt])
  @@index([folioId, chargeType])
  @@index([outletId])
  @@map("line_items")
}

model FolioTransfer {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  sourceFolioId String    @db.Uuid
  targetFolioId String    @db.Uuid
  lineItemIds   String[]  @db.Uuid // snapshot of transferred line items
  amount        Decimal   @db.Decimal(12, 2)
  reason        String // required for audit
  approvedBy    String?   @db.Uuid // NULL if below threshold
  reversedAt    DateTime? @db.Timestamptz(6) // set within 24h window
  reversedBy    String?   @db.Uuid // manager only
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceFolio    Folio  @relation("TransferSource", fields: [sourceFolioId], references: [id], onDelete: Restrict)
  targetFolio    Folio  @relation("TransferTarget", fields: [targetFolioId], references: [id], onDelete: Restrict)
  approvedByUser User?  @relation("TransferApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  reversedByUser User?  @relation("TransferReversedBy", fields: [reversedBy], references: [id], onDelete: SetNull)

  @@index([sourceFolioId])
  @@index([targetFolioId])
  @@map("folio_transfers")
}

// Append-only: voided via isVoid, never removed.
model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @db.Uuid
  folioId        String         @db.Uuid
  method         PaymentMethod
  amount         Decimal        @db.Decimal(12, 2) // positive = payment, negative = refund
  currency       String         @db.Char(3)
  reference      String?        @db.VarChar(100) // card auth code, bank ref; deposit_application references original deposit
  shiftId        String?        @db.Uuid // links payment to cash shift
  paymentPurpose PaymentPurpose @default(payment)
  isVoid         Boolean        @default(false)
  voidedAt       DateTime?      @db.Timestamptz(6)
  voidedBy       String?        @db.Uuid
  voidReason     String?
  recordedAt     DateTime       @default(now()) @db.Timestamptz(6)
  recordedBy     String?        @db.Uuid
  deletedAt      DateTime?      @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  folio          Folio  @relation(fields: [folioId], references: [id], onDelete: Restrict)
  shift          Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  recordedByUser User?  @relation("PaymentRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  voidedByUser   User?  @relation("PaymentVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)

  refunds            Refund[]
  loyaltyTransaction LoyaltyTransaction?

  @@index([folioId, paymentPurpose])
  @@index([shiftId])
  @@map("payments")
}

model Refund {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  folioId     String       @db.Uuid
  paymentId   String?      @db.Uuid // original payment being refunded
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(pending)
  requestedBy String?      @db.Uuid
  approvedBy  String?      @db.Uuid
  processedAt DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  folio           Folio    @relation(fields: [folioId], references: [id], onDelete: Restrict)
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedByUser User?    @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  approvedByUser  User?    @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([folioId])
  @@map("refunds")
}

model TaxRule {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String         @db.Uuid
  branchId             String         @db.Uuid
  name                 String         @db.VarChar(100) // "VAT", "Service Charge", "City Tax"
  rate                 Decimal        @db.Decimal(6, 4) // 0.075 = 7.5%
  type                 AdjustmentType @default(percentage)
  appliesToChargeTypes ChargeType[] // empty = applies to all
  jurisdiction         String?        @db.VarChar(100)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, isActive])
  @@map("tax_rules")
}

// ---------------------------------------------------------------------------
// Operations (10)
