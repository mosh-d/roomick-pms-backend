  blocked

  @@map("held_status_enum")
}

enum BlockReason {
  maintenance
  renovation
  vip_hold
  other

  @@map("block_reason_enum")
}

enum ReservationStatus {
  waitlisted
  confirmed
  checked_in
  checked_out
  cancelled
